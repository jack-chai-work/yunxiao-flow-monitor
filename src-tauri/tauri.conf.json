{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YunxiaoFlowMonitor",
  "version": "0.1.0",
  "identifier": "com.yunxiao.flowmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云效流水线实时监控",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "云效流水线实时监控工具",
    "longDescription": "基于阿里云云效 OpenAPI 的流水线实时监控桌面工具，支持流水线状态总览、运行实例详情、任务步骤实时日志、运行/终止/重跑控制，以及系统托盘常驻与桌面通知。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
