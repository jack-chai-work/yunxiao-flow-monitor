{
  "name": "yunxiao-flow-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "云效流水线实时监控桌面工具（Tauri v2 + Vue 3 + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icon:gen": "node scripts/gen-icon.mjs",
    "icon:build": "node scripts/gen-icon.mjs && tauri icon src-tauri/app-icon.png --output src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
